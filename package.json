{
  "name": "api-performance-testing",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "reset-db": "cp db.seed.json db.json",
    "mock-server": "npm run reset-db && npx kill-port 3000 && json-server db.json --port 3000",
    "test:full": "concurrently -k -s first \"npm run mock-server\" \"wait-on http://localhost:3000/users && playwright test\"",
    "perf:smoke": "k6 run tests/performance/smoke-test.js",
    "perf:load": "k6 run tests/performance/load-test.js",
    "perf:steady": "k6 run tests/performance/steady-load.js",
    "perf:stress": "k6 run tests/performance/stress-test.js",
    "perf:spike": "k6 run tests/performance/spike-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "concurrently": "^9.2.4",
    "dotenv": "^18.0.1",
    "json-server": "^0.17.4",
    "kill-port": "^2.0.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
